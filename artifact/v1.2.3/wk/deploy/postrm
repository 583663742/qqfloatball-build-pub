#!/bin/bash
# QQFloatBall postrm — 卸载清理 dylib/plist/roothidepatch 链接
DYLIB_NAME="QQFloatBall"

for DIR in /var/jb/usr/lib/TweakInject /Library/MobileSubstrate/DynamicLibraries; do
    if [ -d "$DIR" ]; then
        rm -f "$DIR/${DYLIB_NAME}.dylib.roothidepatch" \
              "$DIR/${DYLIB_NAME}.dylib.DISABLED" \
              "$DIR/${DYLIB_NAME}.dylib.bak" \
              "$DIR/${DYLIB_NAME}.plist" \
              "$DIR/${DYLIB_NAME}.dylib"
    fi
done

# 清理插件日志
find /var/mobile/Containers/Data/Application -maxdepth 4 -name "qqflog*" -exec rm -f {} + 2>/dev/null || true
find /var/mobile/Containers/Data/Application -maxdepth 4 -name "QQFloatBall*" -exec rm -f {} + 2>/dev/null || true

exit 0
